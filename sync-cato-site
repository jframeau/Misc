def env_or_none(name: str) -> Optional[str]:
    value = os.getenv(name)
    if value is None:
        return None

    value = value.strip()

    return value if value else None


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description=(
            "Synchronise les sites Cato Networks "
            "avec Centreon via les API REST/GraphQL."
        )
    )

    # ------------------------------------------------------------------------
    # Cato
    # ------------------------------------------------------------------------

    parser.add_argument(
        "--cato-api-key",
        default=env_or_none("CATO_API_KEY"),
        help="Clé API Cato (env: CATO_API_KEY)",
    )

    parser.add_argument(
        "--cato-account-id",
        default=env_or_none("CATO_ACCOUNT_ID"),
        help="Account ID Cato (env: CATO_ACCOUNT_ID)",
    )

    parser.add_argument(
        "--cato-api-url",
        default=(
            env_or_none("CATO_API_URL")
            or DEFAULT_CATO_API_URL
        ),
        help=(
            "URL GraphQL Cato "
            "(env: CATO_API_URL)"
        ),
    )

    # ------------------------------------------------------------------------
    # Centreon
    # ------------------------------------------------------------------------

    parser.add_argument(
        "--centreon-url",
        default=env_or_none("CENTREON_URL"),
        help="URL de base Centreon (env: CENTREON_URL)",
    )

    parser.add_argument(
        "--centreon-api-version",
        default=(
            env_or_none("CENTREON_API_VERSION")
            or DEFAULT_CENTREON_API_VERSION
        ),
        help=(
            "Version API Centreon "
            "(env: CENTREON_API_VERSION, défaut: latest)"
        ),
    )

    parser.add_argument(
        "--centreon-user",
        default=env_or_none("CENTREON_USER"),
        help="Utilisateur Centreon (env: CENTREON_USER)",
    )

    parser.add_argument(
        "--centreon-password",
        default=env_or_none("CENTREON_PASSWORD"),
        help="Mot de passe Centreon (env: CENTREON_PASSWORD)",
    )

    parser.add_argument(
        "--centreon-poller-id",
        type=int,
        default=(
            int(os.environ["CENTREON_POLLER_ID"])
            if env_or_none("CENTREON_POLLER_ID")
            else None
        ),
        help=(
            "ID du poller Centreon pour generate-and-reload "
            "(env: CENTREON_POLLER_ID)"
        ),
    )

    parser.add_argument(
        "--centreon-hostgroup",
        default=env_or_none("CENTREON_HOSTGROUP"),
        help=(
            "Nom du hostgroup Centreon "
            "(env: CENTREON_HOSTGROUP)"
        ),
    )

    parser.add_argument(
        "--centreon-host-address",
        default=(
            env_or_none("CENTREON_HOST_ADDRESS")
            or DEFAULT_HOST_ADDRESS
        ),
        help=(
            "Adresse des hôtes Centreon "
            "(env: CENTREON_HOST_ADDRESS, "
            f"défaut: {DEFAULT_HOST_ADDRESS})"
        ),
    )

    # ------------------------------------------------------------------------
    # Options
    # ------------------------------------------------------------------------

    parser.add_argument(
        "--dry-run",
        action="store_true",
        help=(
            "N'effectue aucune modification Centreon. "
            "Les appels d'écriture, services/deploy et "
            "generate-and-reload sont désactivés."
        ),
    )

    parser.add_argument(
        "--centreon-commit",
        action="store_true",
        help=(
            "Après la synchronisation, lance "
            "generate-and-reload sur le poller indiqué."
        ),
    )

    parser.add_argument(
        "--debug",
        action="store_true",
        help="Active les logs de debug.",
    )

    parser.add_argument(
        "--insecure",
        action="store_true",
        help=(
            "Désactive la vérification SSL "
            "pour les connexions HTTPS."
        ),
    )

    return parser


# ============================================================================
# Validation
# ============================================================================

def require_value(
    value: Optional[str],
    option_name: str,
) -> str:
    if not value:
        raise ValueError(
            f"{option_name} est obligatoire."
        )

    return value


# ============================================================================
# Main
# ============================================================================

def main() -> int:
    parser = build_parser()
    args = parser.parse_args()

    try:
        cato_api_key = require_value(
            args.cato_api_key,
            "--cato-api-key / CATO_API_KEY",
        )

        cato_account_id = require_value(
            args.cato_account_id,
            "--cato-account-id / CATO_ACCOUNT_ID",
        )

        centreon_url = require_value(
            args.centreon_url,
            "--centreon-url / CENTREON_URL",
        )

        centreon_user = require_value(
            args.centreon_user,
            "--centreon-user / CENTREON_USER",
        )

        centreon_password = require_value(
            args.centreon_password,
            "--centreon-password / CENTREON_PASSWORD",
        )

        # Le poller ID n'est obligatoire que si on demande le commit.
        # En dry-run, même --centreon-commit ne provoque aucun reload.
        if args.centreon_commit and not args.dry_run:
            if args.centreon_poller_id is None:
                raise ValueError(
                    "--centreon-poller-id / CENTREON_POLLER_ID "
                    "est obligatoire avec --centreon-commit."
                )

        verify_ssl = not args.insecure

        if args.insecure:
            urllib3.disable_warnings(
                urllib3.exceptions.InsecureRequestWarning
            )

        # --------------------------------------------------------------------
        # Initialisation APIs
        # --------------------------------------------------------------------

        cato = CatoAPI(
            api_key=cato_api_key,
            account_id=cato_account_id,
            api_url=args.cato_api_url,
            verify_ssl=verify_ssl,
            debug=args.debug,
        )

        centreon = CentreonAPI(
            base_url=centreon_url,
            api_version=args.centreon_api_version,
            username=centreon_user,
            password=centreon_password,
            verify_ssl=verify_ssl,
            debug=args.debug,
        )

        # --------------------------------------------------------------------
        # Login Centreon
        # --------------------------------------------------------------------

        print("Connexion à Centreon...")

        centreon.login()

        print("Connexion Centreon OK.")

        # --------------------------------------------------------------------
        # Résolution des templates
        # --------------------------------------------------------------------

        print(
            "Recherche des templates d'hôte Centreon : "
            + ", ".join(HOST_TEMPLATE_NAMES)
        )

        template_ids_by_name = (
            centreon.resolve_host_template_ids(
                HOST_TEMPLATE_NAMES
            )
        )

        for name, template_id in template_ids_by_name.items():
            print(
                f"  {name} -> ID {template_id}"
            )

        # --------------------------------------------------------------------
        # Résolution du hostgroup
        # --------------------------------------------------------------------

        hostgroup_id: Optional[int] = None

        if args.centreon_hostgroup:
            print(
                f"Recherche du hostgroup Centreon "
                f"'{args.centreon_hostgroup}'..."
            )

            hostgroup_id = centreon.resolve_host_group_id(
                args.centreon_hostgroup
            )

            print(
                f"  {args.centreon_hostgroup} "
                f"-> ID {hostgroup_id}"
            )

        # --------------------------------------------------------------------
        # Synchronisation
        # --------------------------------------------------------------------

        synchronizer = Synchronizer(
            cato=cato,
            centreon=centreon,
            dry_run=args.dry_run,
            debug=args.debug,
            host_address=args.centreon_host_address,
            hostgroup_id=hostgroup_id,
            poller_id=args.centreon_poller_id
        )

        synchronizer.run(
            template_ids_by_name
        )

        # --------------------------------------------------------------------
        # Generate + reload
        # --------------------------------------------------------------------

        if args.centreon_commit:
            if args.dry_run:
                print(
                    "\n[DRY-RUN] --centreon-commit demandé, "
                    "mais aucun generate-and-reload ne sera exécuté."
                )
            else:
                print(
                    f"\nGénération et reload de la configuration "
                    f"du poller {args.centreon_poller_id}..."
                )

                centreon.generate_and_reload(
                    args.centreon_poller_id
                )

                print(
                    "Génération et reload Centreon OK."
                )

        else:
            print(
                "\nPas de --centreon-commit : "
                "aucun generate-and-reload exécuté."
            )

        return 0

    except (APIError, ValueError) as exc:
        print(
            f"\nERREUR : {exc}",
            file=sys.stderr,
        )
        return 1

    except KeyboardInterrupt:
        print(
            "\nInterrompu.",
            file=sys.stderr,
        )
        return 130


if __name__ == "__main__":
    sys.exit(main())

